# secrets.yaml.example
#
# Copy this file to secrets.yaml and fill in real values.
# secrets.yaml is gitignored — never commit it.
#
# Reference these in provider configs with: !secret <key>
# Example in providers/homeassistant/config.yaml:
#   token: !secret ha_token

ha_token: "your-home-assistant-long-lived-access-token-here"
gemini_api_key: "your-gemini-api-key-here"
